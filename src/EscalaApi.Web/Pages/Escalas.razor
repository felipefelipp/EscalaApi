@page "/escalas"
@inject EscalaApiService EscalaService
@inject ConfiguracaoEscalaApiService ConfigService
@inject TipoIntegranteApiService TipoService
@inject IntegranteApiService IntegranteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
            Gestão de Escalas
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Gere escalas inteligentes com rotação balanceada, visualize o preview antes de salvar e consulte o histórico.
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.UploadFile"
                   OnClick="@(() => _importarCsvVisible = true)">
            Importar CSV
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoMode"
                   OnClick="@AbrirModalGeracao">
            Gerar Nova Escala
        </MudButton>
    </div>
</div>

@if (!_loading)
{
    @if (_configuracoes.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <div>
                    <b>Nenhum Modelo de Escala cadastrado:</b> Para gerar uma escala inteligente, é necessário cadastrar primeiro um Modelo de Escala definindo o período, os dias e as funções participantes.
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Tune"
                           OnClick="@(() => Navigation.NavigateTo("configuracoes"))">
                    Criar Modelo de Escala
                </MudButton>
            </div>
        </MudAlert>
    }
    else if (_todosIntegrantes.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <div>
                    <b>Nenhum Integrante cadastrado:</b> Para que o algoritmo distribua os voluntários nas datas e funções, é necessário cadastrar os integrantes e vincular suas disponibilidades.
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@(() => Navigation.NavigateTo("integrantes"))">
                    Cadastrar Integrantes
                </MudButton>
            </div>
        </MudAlert>
    }
}

<!-- Filtros de Consulta -->
<MudCard Elevation="1" Class="mb-4 pa-3">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="A partir de" @bind-Date="_filtroDataInicio"
                           DateFormat="dd/MM/yyyy" Margin="Margin.Dense" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Até" @bind-Date="_filtroDataFim"
                           DateFormat="dd/MM/yyyy" Margin="Margin.Dense" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="int?" Label="Função" @bind-Value="_filtroTipo" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">Todas as Funções</MudSelectItem>
                @foreach (var tipo in _catalogoTipos)
                {
                    <MudSelectItem T="int?" Value="@((int?)tipo.IdTipoIntegrante)">@tipo.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CarregarEscalas"
                       StartIcon="@Icons.Material.Filled.FilterAlt">
                Filtrar
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@LimparFiltros">
                Limpar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudCard>

<!-- Tabela de Escalas Persistidas -->
<MudCard Elevation="2">
    <MudCardContent Class="pa-0">
        <MudTable @ref="_table" Items="@_escalas" Dense="true" Hover="true" Striped="true" Loading="@_loading">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Escalas Persistidas (@_escalas.Count slots)</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="@ExportarEscalasSalvasExcel" Size="Size.Small" Class="mr-2" Disabled="@(_escalas.Count == 0)">
                    Exportar Excel
                </MudButton>
                @if (_escalasSelecionadas.Count > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                               OnClick="@ConfirmarExclusaoEmLote" Size="Size.Small" Class="mr-2">
                        Excluir Selecionadas (@_escalasSelecionadas.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               OnClick="@(() => _escalasSelecionadas.Clear())">
                        Desmarcar
                    </MudButton>
                }
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="width: 48px;">
                    <MudCheckBox T="bool?" Value="@ObterEstadoCheckboxHeader()"
                                 ValueChanged="@OnHeaderCheckboxChanged"
                                 Color="Color.Primary" Dense="true" TriState="true" />
                </MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Dia da Semana</MudTh>
                <MudTh>Função / Papel</MudTh>
                <MudTh>Integrante Escalado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool" Value="@_escalasSelecionadas.Contains(context)"
                                 ValueChanged="@((bool val) => OnToggleItem(context, val))"
                                 Color="Color.Primary" Dense="true" />
                </MudTd>
                <MudTd DataLabel="Data">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="Color.Primary" />
                        <span class="font-weight-bold">
                            @(context.Data?.ToString("dd/MM/yyyy") ?? "—")
                        </span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Dia">
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                        @context.Dia
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Função">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                        @context.DescricaoTipoEscala
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Integrante">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(context.NomeIntegrante) ? "?" : context.NomeIntegrante[0].ToString().ToUpper())
                        </MudAvatar>
                        <span class="font-weight-medium">@context.NomeIntegrante</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Ações" Class="text-right">
                    <MudTooltip Text="Editar escala">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => AbrirModalEdicao(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Excluir escala">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => ConfirmarExclusao(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Nenhuma escala encontrada</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                        @if (_configuracoes.Count == 0)
                        {
                            <span>Antes de gerar escalas, você precisa cadastrar um <b>Modelo de Escala</b> definindo período, dias e funções.</span>
                        }
                        else
                        {
                            <span>Use o botão <b>"Gerar Nova Escala"</b> para gerar automaticamente a escala com balanceamento inteligente.</span>
                        }
                    </MudText>
                    @if (_configuracoes.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tune"
                                   OnClick="@(() => Navigation.NavigateTo("configuracoes"))">
                            Criar Primeiro Modelo de Escala
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoMode"
                                   OnClick="@AbrirModalGeracao">
                            Gerar Nova Escala
                        </MudButton>
                    }
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Linhas por página:" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

<!-- Diálogo Assistente de Geração com Preview -->
<MudDialog @bind-Visible="_gerarDialogVisible" Options="_gerarDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoMode" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Assistente de Geração de Escala</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Selecione a configuração desejada. Você poderá conferir o balanceamento de participações antes de salvar definitivamente.
        </MudText>

        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12">
                <MudSelect T="int" Label="Modelo de Escala *" @bind-Value="_configSelecionadaId" Margin="Margin.Dense">
                    @foreach (var c in _configuracoes)
                    {
                        <MudSelectItem T="int" Value="@c.IdConfiguracao">
                            @c.Nome (@c.DataInicio.ToString("dd/MM") a @c.DataFim.ToString("dd/MM/yyyy"))
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @if (ConfiguracaoSelecionada != null)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                Funções que serão geradas (@ConfiguracaoSelecionada.TiposIntegrante.Count):
                            </MudText>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var idTipo in ConfiguracaoSelecionada.TiposIntegrante)
                            {
                                var qtd = ObterQtdIntegrantesTipo(idTipo);
                                <MudChip T="string" Color="@(qtd > 0 ? Color.Primary : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                    @ObterNomeTipo(idTipo) @(qtd > 0 ? $"({qtd})" : "(sem voluntários)")
                                </MudChip>
                            }
                        </div>
                        @{
                            var semVoluntarios = ObterTiposSemIntegrantesNaConfig(ConfiguracaoSelecionada);
                        }
                        @if (semVoluntarios.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                <b>Atenção:</b> As seguintes funções não possuem nenhum voluntário cadastrado: <b>@string.Join(", ", semVoluntarios.Select(t => t.Nome))</b>. As vagas dessas funções ficarão abertas na escala.
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            }
            <MudItem xs="12">
                <MudPaper Class="pa-2 d-flex flex-column h-100" Outlined="true" Elevation="0">
                    <MudSwitch @bind-Value="_impedirMultiplos" Label="Evitar duplicidade no mesmo dia" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                        <b>Ativado:</b> O voluntário atua em no máximo 1 função por evento/data. Se houver carência, aceita vaga aberta.<br/>
                        <b>Desativado:</b> Permite cobrir mais de uma função se faltar voluntário.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="d-flex justify-end mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="@GerarPreview" Disabled="@(_configSelecionadaId == 0 || _gerandoPreview)">
                @(_gerandoPreview ? "Calculando rotação..." : "Gerar Preview")
            </MudButton>
        </div>

        @if (_previewCarregado != null)
        {
            <MudDivider Class="my-3" />

            <!-- Alertas de carência/warnings se existirem -->
            @if (_previewCarregado.Warnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Avisos do Algoritmo de Rotação:</MudText>
                    <ul class="mb-0 pl-4">
                        @foreach (var w in _previewCarregado.Warnings)
                        {
                            <li>@w.Data.ToString("dd/MM/yyyy"): @w.Mensagem</li>
                        }
                    </ul>
                </MudAlert>
            }

            <!-- Tabs: Grade da Escala e Relatório de Balanceamento -->
            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mt-2">
                <MudTabPanel Text="@($"Grade de Escalas ({_previewCarregado.Escalas.Count} vagas)")" Icon="@Icons.Material.Filled.ViewList">
                    <MudTable Items="@_previewCarregado.Escalas" Dense="true" Hover="true" Striped="true" Height="300px">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Dia</MudTh>
                            <MudTh>Função</MudTh>
                            <MudTh>Integrante Sugerido</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Data.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>@context.DiaDaSemana</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                                    @ObterNomeTipo(context.TipoEscala)
                                </MudChip>
                            </MudTd>
                            <MudTd Class="font-weight-bold">@context.Integrante?.Nome</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="Relatório de Equidade" Icon="@Icons.Material.Filled.Equalizer">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                        Contagem de vezes em que cada voluntário foi escalado no período:
                    </MudText>
                    @foreach (var bal in _previewCarregado.Balanceamento)
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                @(string.IsNullOrWhiteSpace(bal.TipoIntegranteNome) ? ObterNomeTipo(bal.TipoIntegranteId) : bal.TipoIntegranteNome) - @bal.DiaSemana (Desvio: @bal.DesvioMaximo)
                            </MudText>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @foreach (var c in bal.Contagens)
                                {
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                                        @c.Nome: <b>@c.TotalEscalado x</b>
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _gerarDialogVisible = false)">Fechar</MudButton>
        @if (_previewCarregado != null && _previewCarregado.Escalas.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="@ExportarPreviewExcel">
                Exportar Excel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="@ConfirmarEPersistir" Disabled="@_salvandoEscala">
                @(_salvandoEscala ? "Persistindo..." : "Aprovar e Salvar Escala")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- Diálogo de Importação CSV -->
<MudDialog @bind-Visible="_importarCsvVisible" Options="_dialogOptionsPequeno">
    <TitleContent>
        <MudText Typo="Typo.h6">Importar Escalas em Lote (CSV)</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            O arquivo deve conter uma coluna <code>Data</code> e colunas com os nomes das funções correspondentes ao catálogo.
        </MudText>

        <div class="d-flex flex-column gap-2">
            <InputFile id="csvFileInput" OnChange="@ArquivoSelecionado" accept=".csv" style="display:none;" />
            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload" for="csvFileInput">
                @(_arquivoCsv != null ? _arquivoCsv.Name : "Selecionar Arquivo .CSV")
            </MudButton>
            @if (_arquivoCsv != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">
                    Arquivo selecionado: @_arquivoCsv.Name (@(_arquivoCsv.Size / 1024) KB)
                </MudText>
            }
        </div>

        <MudCheckBox @bind-Value="_substituirExistentes" Label="Substituir escalas existentes nas mesmas datas"
                     Color="Color.Warning" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _importarCsvVisible = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@EnviarCsv"
                   Disabled="@(_arquivoCsv == null || _enviandoCsv)">
            @(_enviandoCsv ? "Importando..." : "Importar")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Diálogo de Edição de Escala -->
<MudDialog @bind-Visible="_editarDialogVisible" Options="_dialogOptionsPequeno">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Editar Escala #@_escalaEmEdicao?.IdEscala</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_escalaEmEdicao != null)
        {
            <div class="d-flex flex-column gap-3">
                <MudDatePicker Label="Data da Escala *" @bind-Date="_escalaEmEdicao.Data"
                               DateFormat="dd/MM/yyyy" Margin="Margin.Dense" Required="true" />

                <MudSelect T="int" Label="Função / Papel *" @bind-Value="_escalaEmEdicao.TipoEscala" Margin="Margin.Dense">
                    @foreach (var tipo in _catalogoTipos)
                    {
                        <MudSelectItem T="int" Value="@tipo.IdTipoIntegrante">@tipo.Nome</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" Label="Integrante Escalado *" @bind-Value="_escalaEmEdicao.IdIntegrante" Margin="Margin.Dense">
                    @foreach (var integrante in _todosIntegrantes)
                    {
                        <MudSelectItem T="int" Value="@integrante.IdIntegrante">@integrante.Nome</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editarDialogVisible = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SalvarEdicaoEscala"
                   Disabled="@_salvandoEdicao">
            @(_salvandoEdicao ? "Salvando..." : "Salvar Alterações")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<EscalaResponseModel>? _table;
    private List<EscalaResponseModel> _escalas = [];
    private HashSet<EscalaResponseModel> _escalasSelecionadas = [];
    private List<TipoIntegranteModel> _catalogoTipos = [];
    private List<ConfiguracaoEscalaModel> _configuracoes = [];
    private List<IntegranteModel> _todosIntegrantes = [];
    private bool _loading = true;

    private List<EscalaResponseModel> ObterItensExibidos()
    {
        if (_table == null || _table.FilteredItems == null)
            return _escalas.Take(10).ToList();

        var rowsPerPage = _table.RowsPerPage <= 0 ? 10 : _table.RowsPerPage;
        return _table.FilteredItems
            .Skip(_table.CurrentPage * rowsPerPage)
            .Take(rowsPerPage)
            .ToList();
    }

    private bool? ObterEstadoCheckboxHeader()
    {
        var exibidas = ObterItensExibidos();
        if (exibidas.Count == 0) return false;
        var selecionadasNaPagina = exibidas.Count(e => _escalasSelecionadas.Contains(e));
        if (selecionadasNaPagina == 0) return false;
        if (selecionadasNaPagina == exibidas.Count) return true;
        return null;
    }

    private void OnHeaderCheckboxChanged(bool? valor)
    {
        var exibidas = ObterItensExibidos();
        var marcar = valor == true;
        if (marcar)
        {
            foreach (var item in exibidas)
                _escalasSelecionadas.Add(item);
        }
        else
        {
            foreach (var item in exibidas)
                _escalasSelecionadas.Remove(item);
        }
    }

    private void OnToggleItem(EscalaResponseModel item, bool marcar)
    {
        if (marcar)
            _escalasSelecionadas.Add(item);
        else
            _escalasSelecionadas.Remove(item);
    }

    private DateTime? _filtroDataInicio;
    private DateTime? _filtroDataFim;
    private int? _filtroTipo;

    // Estado da Edição de Escala
    private bool _editarDialogVisible = false;
    private bool _salvandoEdicao = false;
    private EditarEscalaModel? _escalaEmEdicao;

    // Estado da Geração de Escala
    private bool _gerarDialogVisible = false;
    private int _configSelecionadaId = 0;
    private bool _impedirMultiplos = true;
    private bool _gerandoPreview = false;
    private bool _salvandoEscala = false;
    private ResultadoPreviewModel? _previewCarregado;

    // Estado do Upload CSV
    private bool _importarCsvVisible = false;
    private IBrowserFile? _arquivoCsv;
    private bool _substituirExistentes = false;
    private bool _enviandoCsv = false;

    private readonly DialogOptions _gerarDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions _dialogOptionsPequeno = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CarregarTipos(), CarregarConfiguracoes(), CarregarIntegrantes(), CarregarEscalas());
    }

    private async Task CarregarTipos()
    {
        _catalogoTipos = await TipoService.ListarAsync();
    }

    private async Task CarregarConfiguracoes()
    {
        _configuracoes = await ConfigService.ListarAsync();
    }

    private async Task CarregarIntegrantes()
    {
        var response = await IntegranteService.ObterIntegrantesAsync(skip: 0, take: 100);
        _todosIntegrantes = response?.Integrantes ?? [];
    }

    private async Task CarregarEscalas()
    {
        _loading = true;
        _escalasSelecionadas.Clear();
        var filtro = new EscalaFiltroModel
        {
            DataInicio = _filtroDataInicio,
            DataFim = _filtroDataFim,
            TipoIntegrante = _filtroTipo
        };
        _escalas = await EscalaService.ObterEscalasAsync(filtro);
        _loading = false;
    }

    private async Task LimparFiltros()
    {
        _filtroDataInicio = null;
        _filtroDataFim = null;
        _filtroTipo = null;
        _escalasSelecionadas.Clear();
        await CarregarEscalas();
    }

    private string ObterNomeTipo(int idTipo)
    {
        var tipo = _catalogoTipos.FirstOrDefault(t => t.IdTipoIntegrante == idTipo);
        return tipo?.Nome ?? $"Função #{idTipo}";
    }

    private ConfiguracaoEscalaModel? ConfiguracaoSelecionada =>
        _configuracoes.FirstOrDefault(c => c.IdConfiguracao == _configSelecionadaId);

    private void AbrirModalEdicao(EscalaResponseModel escala)
    {
        _escalaEmEdicao = new EditarEscalaModel
        {
            IdEscala = escala.IdEscala,
            Data = escala.Data,
            IdIntegrante = escala.IdIntegrante ?? 0,
            TipoEscala = escala.CodigoTipoEscala
        };
        _editarDialogVisible = true;
    }

    private async Task SalvarEdicaoEscala()
    {
        if (_escalaEmEdicao == null || _escalaEmEdicao.Data == null || _escalaEmEdicao.IdIntegrante == 0 || _escalaEmEdicao.TipoEscala == 0)
        {
            Snackbar.Add("Preencha todos os campos da escala.", Severity.Warning);
            return;
        }

        _salvandoEdicao = true;
        var sucesso = await EscalaService.EditarEscalaAsync(_escalaEmEdicao.IdEscala, _escalaEmEdicao);
        _salvandoEdicao = false;

        if (sucesso)
        {
            Snackbar.Add("Escala atualizada com sucesso!", Severity.Success);
            _editarDialogVisible = false;
            await CarregarEscalas();
        }
        else
        {
            Snackbar.Add("Erro ao atualizar escala.", Severity.Error);
        }
    }

    private async Task ConfirmarExclusao(EscalaResponseModel escala)
    {
        var nome = string.IsNullOrWhiteSpace(escala.NomeIntegrante) ? "vaga aberta" : escala.NomeIntegrante;
        var dataStr = escala.Data?.ToString("dd/MM/yyyy") ?? "";
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Excluir Escala",
            $"Tem certeza que deseja excluir a escala do dia {dataStr} ({escala.DescricaoTipoEscala} - {nome})?",
            yesText: "Excluir", cancelText: "Cancelar");

        if (result == true)
        {
            var sucesso = await EscalaService.ExcluirEscalaAsync(escala.IdEscala);
            if (sucesso)
            {
                Snackbar.Add("Escala excluída com sucesso!", Severity.Success);
                await CarregarEscalas();
            }
            else
            {
                Snackbar.Add("Erro ao excluir escala.", Severity.Error);
            }
        }
    }

    private async Task ConfirmarExclusaoEmLote()
    {
        if (_escalasSelecionadas.Count == 0) return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Excluir Escalas em Lote",
            $"Tem certeza que deseja excluir as {_escalasSelecionadas.Count} escalas selecionadas permanentemente?",
            yesText: "Excluir Todas", cancelText: "Cancelar");

        if (result == true)
        {
            var ids = _escalasSelecionadas.Select(e => e.IdEscala).ToList();
            var sucesso = await EscalaService.ExcluirEscalasEmLoteAsync(ids);
            if (sucesso)
            {
                Snackbar.Add($"{ids.Count} escala(s) excluída(s) com sucesso!", Severity.Success);
                await CarregarEscalas();
            }
            else
            {
                Snackbar.Add("Erro ao excluir escalas em lote.", Severity.Error);
            }
        }
    }

    private async Task AbrirModalGeracao()
    {
        if (_configuracoes.Count == 0)
        {
            bool? irModelos = await DialogService.ShowMessageBoxAsync(
                "Falta Modelo de Escala",
                "Para gerar uma escala inteligente, você precisa primeiro criar um Modelo de Escala (definindo período, dias de eventos e funções participantes).\n\nDeseja criar um Modelo de Escala agora?",
                yesText: "Criar Modelo de Escala", cancelText: "Cancelar");

            if (irModelos == true)
                Navigation.NavigateTo("configuracoes");

            return;
        }

        if (_todosIntegrantes.Count == 0)
        {
            bool? irIntegrantes = await DialogService.ShowMessageBoxAsync(
                "Nenhum Integrante Cadastrado",
                "Não há integrantes cadastrados no sistema.\n\nSe a escala for gerada sem integrantes, todas as vagas ficarão abertas.\n\nDeseja cadastrar integrantes agora?",
                yesText: "Ir para Integrantes", cancelText: "Continuar Mesmo Assim");

            if (irIntegrantes == true)
            {
                Navigation.NavigateTo("integrantes");
                return;
            }
        }

        _previewCarregado = null;
        if (_configuracoes.Count > 0 && _configSelecionadaId == 0)
            _configSelecionadaId = _configuracoes.First().IdConfiguracao;
        _gerarDialogVisible = true;
    }

    private async Task GerarPreview()
    {
        if (_configSelecionadaId == 0)
            return;

        _gerandoPreview = true;
        var request = new GerarEscalaRequest
        {
            ConfiguracaoEscalaId = _configSelecionadaId,
            ImpedirMultiplosTiposMesmoDia = _impedirMultiplos,
            Persistir = false
        };

        _previewCarregado = await EscalaService.GerarPreviewAsync(request);
        _gerandoPreview = false;

        if (_previewCarregado == null || _previewCarregado.Escalas.Count == 0)
        {
            Snackbar.Add("Não foi possível gerar preview. Verifique se há voluntários disponíveis para as datas e funções.", Severity.Warning);
        }
        else
        {
            Snackbar.Add($"Preview gerado com sucesso! {_previewCarregado.Escalas.Count} vagas preenchidas.", Severity.Success);
        }
    }

    private async Task ConfirmarEPersistir()
    {
        if (_configSelecionadaId == 0)
            return;

        _salvandoEscala = true;
        var request = new GerarEscalaRequest
        {
            ConfiguracaoEscalaId = _configSelecionadaId,
            ImpedirMultiplosTiposMesmoDia = _impedirMultiplos,
            Persistir = true
        };

        var sucesso = await EscalaService.ConfirmarEPersistirAsync(request);
        _salvandoEscala = false;

        if (sucesso)
        {
            Snackbar.Add("Escala salva e persistida com sucesso no banco de dados!", Severity.Success);
            _gerarDialogVisible = false;
            await CarregarEscalas();
        }
        else
        {
            Snackbar.Add("Erro ao persistir a escala.", Severity.Error);
        }
    }

    private void ArquivoSelecionado(InputFileChangeEventArgs e)
    {
        _arquivoCsv = e.File;
    }

    private async Task EnviarCsv()
    {
        if (_arquivoCsv == null) return;

        _enviandoCsv = true;
        var sucesso = await EscalaService.ImportarCsvAsync(_arquivoCsv, _substituirExistentes);
        _enviandoCsv = false;

        if (sucesso)
        {
            Snackbar.Add("Arquivo CSV importado com sucesso!", Severity.Success);
            _importarCsvVisible = false;
            _arquivoCsv = null;
            await CarregarEscalas();
        }
        else
        {
            Snackbar.Add("Erro ao importar CSV. Verifique o formato do arquivo e colunas.", Severity.Error);
        }
    }

    private async Task ExportarPreviewExcel()
    {
        if (_previewCarregado == null || _previewCarregado.Escalas.Count == 0)
            return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Data;Dia da Semana;Função;Integrante");
        foreach (var item in _previewCarregado.Escalas)
        {
            var nomeTipo = ObterNomeTipo(item.TipoEscala);
            var nomeIntegrante = item.Integrante?.Nome ?? "";
            sb.AppendLine($"{item.Data:dd/MM/yyyy};{item.DiaDaSemana};\"{nomeTipo}\";\"{nomeIntegrante}\"");
        }

        var csvContent = "\uFEFF" + sb.ToString();
        var fileName = $"preview_escala_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, csvContent, "text/csv;charset=utf-8");
        Snackbar.Add("Arquivo Excel exportado com sucesso!", Severity.Success);
    }

    private async Task ExportarEscalasSalvasExcel()
    {
        if (_escalas.Count == 0)
            return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Data;Dia da Semana;Função;Integrante");
        foreach (var item in _escalas)
        {
            var dataStr = item.Data?.ToString("dd/MM/yyyy") ?? "";
            sb.AppendLine($"{dataStr};{item.Dia};\"{item.DescricaoTipoEscala}\";\"{item.NomeIntegrante}\"");
        }

        var csvContent = "\uFEFF" + sb.ToString();
        var fileName = $"escalas_persistidas_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, csvContent, "text/csv;charset=utf-8");
        Snackbar.Add("Arquivo Excel exportado com sucesso!", Severity.Success);
    }

    private int ObterQtdIntegrantesTipo(int idTipo)
    {
        return _todosIntegrantes.Count(i => i.TipoIntegrante != null && i.TipoIntegrante.Contains(idTipo));
    }

    private List<TipoIntegranteModel> ObterTiposSemIntegrantesNaConfig(ConfiguracaoEscalaModel config)
    {
        return _catalogoTipos
            .Where(t => config.TiposIntegrante != null && config.TiposIntegrante.Contains(t.IdTipoIntegrante) && ObterQtdIntegrantesTipo(t.IdTipoIntegrante) == 0)
            .ToList();
    }
}
