@page "/configuracoes"
@page "/modelos-escala"
@inject ConfiguracaoEscalaApiService ConfigService
@inject TipoIntegranteApiService TipoService
@inject IntegranteApiService IntegranteService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
            Modelos de Escala
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Defina os moldes de geração: período (início e fim), dias recorrentes de eventos e funções participantes necessárias para gerar as escalas.
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.People"
                   OnClick="@(() => Navigation.NavigateTo("integrantes"))">
            Ver Integrantes
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@AbrirModalNovo">
            Novo Modelo de Escala
        </MudButton>
    </div>
</div>

@if (!_loading)
{
    @if (_catalogoTipos.Count == 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <div>
                    <b>Nenhuma Função / Tipo de Integrante cadastrado:</b> Você precisa cadastrar as funções no catálogo (ex.: Bateria, Baixo, Voz) antes de criar os modelos de escala.
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Badge"
                           OnClick="@(() => Navigation.NavigateTo("tipos-integrante"))">
                    Cadastrar Funções
                </MudButton>
            </div>
        </MudAlert>
    }
    else if (_todosIntegrantes.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <div>
                    <b>Nenhum Integrante cadastrado:</b> Para que as escalas geradas sejam preenchidas com voluntários, é necessário cadastrar integrantes e associá-los às funções e dias de disponibilidade.
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@(() => Navigation.NavigateTo("integrantes"))">
                    Cadastrar Integrantes
                </MudButton>
            </div>
        </MudAlert>
    }
}

<MudCard Elevation="2">
    <MudCardContent Class="pa-0">
        <MudTable Items="@_configs" Dense="true" Hover="true" Striped="true" Loading="@_loading">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Nome do Modelo</MudTh>
                <MudTh>Período</MudTh>
                <MudTh>Dias Recorrentes</MudTh>
                <MudTh>Funções Participantes</MudTh>
                <MudTh Class="text-right">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.IdConfiguracao</MudTd>
                <MudTd DataLabel="Nome" Class="font-weight-bold">@context.Nome</MudTd>
                <MudTd DataLabel="Período">
                    @context.DataInicio.ToString("dd/MM/yyyy") até @context.DataFim.ToString("dd/MM/yyyy")
                </MudTd>
                <MudTd DataLabel="Dias">
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var dia in context.ValoresRecorrentes)
                        {
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">
                                @TraduzirDia(dia)
                            </MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Funções">
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var idTipo in context.TiposIntegrante)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @ObterNomeTipo(idTipo)
                            </MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Ações" Class="text-right">
                    <MudTooltip Text="Editar modelo">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => AbrirModalEdicao(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Excluir modelo">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => ConfirmarExclusao(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Nenhum modelo de escala cadastrado</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                        Crie um modelo informando o período (ex: próximo mês ou trimestre), dias de eventos e funções participantes.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@AbrirModalNovo">
                        Criar Primeiro Modelo de Escala
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </MudCardContent>
</MudCard>

<!-- Diálogo de Criação / Edição -->
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(_editandoId.HasValue ? "Editar Modelo de Escala" : "Novo Modelo de Escala")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Defina o período, os dias da semana em que os eventos acontecem e selecione quais funções farão parte desta escala.
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="@_formValido">
            <MudTextField @bind-Value="_nome" Label="Nome do Modelo (ex.: Q1 2026 - Cultos Gerais, Louvor) *"
                          Required="true" RequiredError="O nome do modelo é obrigatório."
                          Margin="Margin.Dense" Class="mb-3" />

            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Início *" @bind-Date="_dataInicio"
                                   DateFormat="dd/MM/yyyy" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Fim *" @bind-Date="_dataFim"
                                   DateFormat="dd/MM/yyyy" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @if (_dataInicio.HasValue && _dataFim.HasValue && _dataInicio > _dataFim)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    A data inicial não pode ser posterior à data final.
                </MudAlert>
            }
            else if (!PossuiOcorrenciasNoPeriodo())
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Atenção: O período de @(_dataInicio?.ToString("dd/MM/yyyy")) a @(_dataFim?.ToString("dd/MM/yyyy")) não contém nenhum dos dias da semana selecionados abaixo.
                </MudAlert>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1 font-weight-bold">Dias da Semana Recorrentes *</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Dias em que haverá escala dentro do período:</MudText>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var (valor, label) in _diasSemanaOpcoes)
                {
                    var isSelected = _diasSelecionados.Contains(valor);
                    <MudChip T="string" Color="@(isSelected ? Color.Secondary : Color.Default)"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleDia(valor))"
                             Class="cursor-pointer">
                        @label
                    </MudChip>
                }
            </div>

            <div class="d-flex justify-space-between align-center mt-3 mb-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Funções Participantes *</MudText>
                <div class="d-flex gap-1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@SelecionarTodosTipos">
                        Marcar Todas
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="@LimparTipos">
                        Limpar
                    </MudButton>
                </div>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                Selecione as funções participantes (indicamos a quantidade de voluntários disponíveis cadastrados):
            </MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var tipo in _catalogoTipos)
                {
                    var isSelected = _tiposSelecionados.Contains(tipo.IdTipoIntegrante);
                    var qtdIntegrantes = ObterQtdIntegrantesTipo(tipo.IdTipoIntegrante);
                    var chipColor = isSelected ? (qtdIntegrantes == 0 ? Color.Warning : Color.Primary) : Color.Default;

                    <MudChip T="string" Color="@chipColor"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleTipo(tipo.IdTipoIntegrante))"
                             Class="cursor-pointer">
                        @(isSelected ? "✓ " : "")@tipo.Nome (@(qtdIntegrantes == 1 ? "1 voluntário" : $"{qtdIntegrantes} voluntários"))
                    </MudChip>
                }
            </div>

            @{
                var tiposSemVoluntarios = ObterTiposSelecionadosSemIntegrantes();
            }
            @if (tiposSemVoluntarios.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    <b>Funções sem voluntários:</b> As funções selecionadas (@string.Join(", ", tiposSemVoluntarios.Select(t => t.Nome))) não têm nenhum integrante cadastrado. Suas vagas ficarão abertas até que integrantes sejam adicionados.
                </MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogVisible = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SalvarConfiguracao"
                   Disabled="@(!_formValido || _diasSelecionados.Count == 0 || _tiposSelecionados.Count == 0 || (_dataInicio > _dataFim) || !PossuiOcorrenciasNoPeriodo())">
            Salvar Modelo
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ConfiguracaoEscalaModel> _configs = [];
    private List<TipoIntegranteModel> _catalogoTipos = [];
    private List<IntegranteModel> _todosIntegrantes = [];
    private bool _loading = true;

    private bool _dialogVisible = false;
    private int? _editandoId = null;
    private string _nome = "";
    private DateTime? _dataInicio = DateTime.Today;
    private DateTime? _dataFim = DateTime.Today.AddMonths(1);
    private HashSet<int> _diasSelecionados = [];
    private HashSet<int> _tiposSelecionados = [];

    private MudForm? _form;
    private bool _formValido;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private readonly List<(int valor, string label)> _diasSemanaOpcoes =
    [
        (0, "Domingo"),
        (1, "Segunda"),
        (2, "Terça"),
        (3, "Quarta"),
        (4, "Quinta"),
        (5, "Sexta"),
        (6, "Sábado")
    ];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CarregarTipos(), CarregarConfiguracoes(), CarregarIntegrantes());
    }

    private async Task CarregarTipos()
    {
        _catalogoTipos = await TipoService.ListarAsync();
    }

    private async Task CarregarIntegrantes()
    {
        var response = await IntegranteService.ObterIntegrantesAsync(skip: 0, take: 100);
        _todosIntegrantes = response?.Integrantes ?? [];
    }

    private async Task CarregarConfiguracoes()
    {
        _loading = true;
        _configs = await ConfigService.ListarAsync();
        _loading = false;
    }

    private int ObterQtdIntegrantesTipo(int idTipo)
    {
        return _todosIntegrantes.Count(i => i.TipoIntegrante != null && i.TipoIntegrante.Contains(idTipo));
    }

    private List<TipoIntegranteModel> ObterTiposSelecionadosSemIntegrantes()
    {
        return _catalogoTipos
            .Where(t => _tiposSelecionados.Contains(t.IdTipoIntegrante) && ObterQtdIntegrantesTipo(t.IdTipoIntegrante) == 0)
            .ToList();
    }

    private bool PossuiOcorrenciasNoPeriodo()
    {
        if (!_dataInicio.HasValue || !_dataFim.HasValue || _diasSelecionados.Count == 0) return true;
        if (_dataInicio > _dataFim) return false;

        for (var dt = _dataInicio.Value.Date; dt <= _dataFim.Value.Date; dt = dt.AddDays(1))
        {
            var diaInt = (int)dt.DayOfWeek;
            if (_diasSelecionados.Contains(diaInt))
                return true;
        }
        return false;
    }

    private string ObterNomeTipo(int idTipo)
    {
        var tipo = _catalogoTipos.FirstOrDefault(t => t.IdTipoIntegrante == idTipo);
        return tipo?.Nome ?? $"Tipo #{idTipo}";
    }

    private string TraduzirDia(int dia) => dia switch
    {
        0 => "Domingo",
        1 => "Segunda",
        2 => "Terça",
        3 => "Quarta",
        4 => "Quinta",
        5 => "Sexta",
        6 => "Sábado",
        _ => $"Dia {dia}"
    };

    private void ToggleDia(int dia)
    {
        if (_diasSelecionados.Contains(dia))
            _diasSelecionados.Remove(dia);
        else
            _diasSelecionados.Add(dia);
    }

    private void ToggleTipo(int idTipo)
    {
        if (_tiposSelecionados.Contains(idTipo))
            _tiposSelecionados.Remove(idTipo);
        else
            _tiposSelecionados.Add(idTipo);
    }

    private void SelecionarTodosTipos()
    {
        _tiposSelecionados = new HashSet<int>(_catalogoTipos.Select(t => t.IdTipoIntegrante));
    }

    private void LimparTipos()
    {
        _tiposSelecionados.Clear();
    }

    private async Task AbrirModalNovo()
    {
        if (_catalogoTipos.Count == 0)
        {
            bool? irTipos = await DialogService.ShowMessageBoxAsync(
                "Nenhuma Função Cadastrada",
                "Antes de criar um Modelo de Escala, é necessário cadastrar as funções participantes (ex: Bateria, Baixo, Voz) no catálogo.\n\nDeseja ir para a página de Funções agora?",
                yesText: "Ir para Funções", cancelText: "Fechar");

            if (irTipos == true)
                Navigation.NavigateTo("tipos-integrante");

            return;
        }

        if (_todosIntegrantes.Count == 0)
        {
            bool? irIntegrantes = await DialogService.ShowMessageBoxAsync(
                "Nenhum Integrante Cadastrado",
                "Você ainda não cadastrou nenhum integrante no sistema. O modelo de escala pode ser criado agora, mas para gerar escalas completas você precisará de voluntários vinculados.\n\nDeseja cadastrar integrantes primeiro?",
                yesText: "Ir para Integrantes", cancelText: "Continuar Criando Modelo");

            if (irIntegrantes == true)
            {
                Navigation.NavigateTo("integrantes");
                return;
            }
        }

        _editandoId = null;
        _nome = "";
        _dataInicio = DateTime.Today;
        _dataFim = DateTime.Today.AddMonths(1);
        _diasSelecionados = [0, 3]; // Domingo e Quarta padrão
        _tiposSelecionados = new HashSet<int>(_catalogoTipos.Select(t => t.IdTipoIntegrante));
        _dialogVisible = true;
    }

    private void AbrirModalEdicao(ConfiguracaoEscalaModel config)
    {
        _editandoId = config.IdConfiguracao;
        _nome = config.Nome;
        _dataInicio = config.DataInicio;
        _dataFim = config.DataFim;
        _diasSelecionados = new HashSet<int>(config.ValoresRecorrentes ?? []);
        _tiposSelecionados = new HashSet<int>(config.TiposIntegrante ?? []);
        _dialogVisible = true;
    }

    private async Task SalvarConfiguracao()
    {
        if (string.IsNullOrWhiteSpace(_nome) || !_dataInicio.HasValue || !_dataFim.HasValue)
            return;

        if (_dataInicio > _dataFim)
        {
            Snackbar.Add("A data inicial não pode ser maior que a data final.", Severity.Warning);
            return;
        }

        if (!PossuiOcorrenciasNoPeriodo())
        {
            Snackbar.Add("O período selecionado não contempla nenhum dos dias recorrentes marcados.", Severity.Warning);
            return;
        }

        var request = new ConfiguracaoEscalaRequest
        {
            Nome = _nome.Trim(),
            DataInicio = _dataInicio.Value,
            DataFim = _dataFim.Value,
            ValoresRecorrentes = _diasSelecionados.ToList(),
            TiposIntegrante = _tiposSelecionados.ToList()
        };

        bool sucesso;
        if (_editandoId.HasValue)
        {
            sucesso = await ConfigService.AtualizarAsync(_editandoId.Value, request);
        }
        else
        {
            sucesso = await ConfigService.InserirAsync(request);
        }

        if (sucesso)
        {
            Snackbar.Add("Modelo de escala salvo com sucesso!", Severity.Success);
            _dialogVisible = false;
            await CarregarConfiguracoes();
        }
        else
        {
            Snackbar.Add("Erro ao salvar modelo. Verifique as informações e permissões.", Severity.Error);
        }
    }

    private async Task ConfirmarExclusao(ConfiguracaoEscalaModel config)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Excluir Modelo de Escala",
            $"Tem certeza que deseja excluir o modelo \"{config.Nome}\"? Esta ação não poderá ser desfeita.",
            yesText: "Excluir", cancelText: "Cancelar");

        if (result == true)
        {
            var (sucesso, mensagemErro) = await ConfigService.ExcluirAsync(config.IdConfiguracao);
            if (sucesso)
            {
                Snackbar.Add("Modelo de escala excluído com sucesso!", Severity.Success);
                await CarregarConfiguracoes();
            }
            else
            {
                Snackbar.Add(mensagemErro ?? "Não foi possível excluir o modelo. Ele pode conter escalas geradas.", Severity.Warning);
            }
        }
    }
}
